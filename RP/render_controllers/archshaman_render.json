{
    "format_version": "1.8.0",
    "render_controllers": {
        "controller.render.overgrown": {
            "is_hurt_color": {
                "r": 0.11,
                "g": 0.74,
                "b": 0.0,
                "a": 0.25
            },
            "arrays": {
                "textures": {
                    "Array.skins": [
                        "Texture.default"
                    ]
                }
            },
            "geometry": "geometry.default",
            "part_visibility": [
                {
                    "*": "query.variant == 0"
                }
            ],
            "materials": [
                {
                    "*": "material.default"
                }
            ],
            "textures": [
                "array.skins[query.variant]"
            ]
        },
        "controller.render.archshaman_armor": {
            "geometry": "Geometry.armor",
            "is_hurt_color": {
                "r": 0,
                "g": 0,
                "b": 0,
                "a": 0
            },
            "arrays": {
                "textures": {
                    "Array.skins": [
                        "Texture.armor_1",
                        "Texture.armor_2",
                        "Texture.armor_3"
                    ]
                }
            },
            "textures": [
                "Array.skins[query.property('spimton:phase') -1]"
            ],
            "part_visibility": [
                {
                    "*": "query.property('spimton:armor_visible')"
                }
            ],
            "materials": [
                {
                    "*": "material.armor"
                }
            ]
        },
        "controller.render.goulden_boi": {
            "geometry": "Geometry.default",
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "textures": [
                "Texture.default"
            ],
            "part_visibility": [
                {
                    "*": "!query.is_sheared"
                }
            ]
        },
        "controller.render.goulden_boi_rune": {
            "geometry": "Geometry.spawn",
            "materials": [
                {
                    "*": "Material.spawn"
                }
            ],
            "part_visibility": [
                {
                    "*": "query.is_sheared"
                }
            ],
            "textures": [
                "Texture.spawn"
            ],
            "ignore_lighting": false
        },
        "controller.render.square_warning": {
            "uv_anim": {
                "offset": [
                    0,
                    "math.mod(math.floor(q.life_time * 10), 2) / 2"
                ],
                "scale": [
                    1,
                    "1 / 2"
                ]
            },
            "arrays": {
                "textures": {
                    "Array.texture": [
                        "Texture.default",
                        "Texture.second"
                    ]
                }
            },
            "textures": [
                "Array.texture[query.property('spimton:texture')- 1]"
            ],
            "geometry": "Geometry.default",
            "ignore_lighting": true
        }
    }
}