{
    "format_version": "1.8.0",
    "render_controllers": {
        "controller.render.weeper": {
            "is_hurt_color": {
                "r": 0.88,
                "g": 0.11,
                "b": 0.0,
                "a": 0.25
            },
            "arrays": {
                "textures": {
                    "Array.skins": [
                        "Texture.default",
                        "Texture.transient",
                        "Texture.death"
                    ]
                }
            },
            "geometry": "geometry.default",
            "part_visibility": [
                {
                    "*": "query.mark_variant == 0 || query.mark_variant == 1 || query.mark_variant == 2"
                }
            ],
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "textures": [
                "array.skins[query.mark_variant]"
            ]
        },
        "controller.render.nopara": {
            "geometry": "Geometry.default",
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "textures": [
                "Texture.default"
            ],
            "is_hurt_color": {
                "r": 0.88,
                "g": 0.11,
                "b": 0.0,
                "a": 0.25
            },
            "part_visibility": [
                {
                    "*": true
                }
            ]
        },
        "controller.render.parachute": {
            "geometry": "Geometry.parachute",
            "materials": [
                {
                    "*": "Material.parachute"
                }
            ],
            "part_visibility": [
                {
                    "*": "query.is_sheared"
                }
            ],
            "textures": [
                "Texture.parachute"
            ],
            "ignore_lighting": true
        },
        "controller.render.guard_statue": {
            "is_hurt_color": {
                "a": 0,
                "b": 0,
                "g": 0,
                "r": 0
            },
            "geometry": "Geometry.default",
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "textures": [
                "Texture.default"
            ]
        },
        "controller.render.weeper_armor": {
            "geometry": "Geometry.armor",
            "is_hurt_color": {
                "a": 0,
                "b": 0,
                "g": 0,
                "r": 0
            },
            "materials": [
                {
                    "*": "Material.armor"
                }
            ],
            "textures": [
                "Texture.armor"
            ],
            "part_visibility": [
                {
                    "*": "query.property('spimton:armor')"
                }
            ],
            "uv_anim": {
                "offset": [
                    "(query.property('spimton:armor') ? (Math.cos(query.life_time * 22.92) * 3) : 0.0)",
                    "(query.property('spimton:armor') ? (query.life_time * 0.2) : 0.0)"
                ],
                "scale": [
                    1.0,
                    1.0
                ]
            },
            "ignore_lighting": true
        },
        "controller.render.weeper_neo": {
            "is_hurt_color": {
                "r": 0.88,
                "g": 0.11,
                "b": 0.0,
                "a": 0.25
            },
            "arrays": {
                "textures": {
                    "Array.skins": [
                        "Texture.death",
                        "Texture.default",
                        "Texture.default",
                        "Texture.default",
                        "Texture.death"
                    ]
                }
            },
            "geometry": "geometry.default",
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "textures": [
                "array.skins[query.property('spimton:phase')]"
            ]
        }
    }
}