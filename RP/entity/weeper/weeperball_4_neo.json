{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "spimton:weeperball_4_neo",
            "materials": {
                "default": "arrow"
            },
            "textures": {
                "default": "textures/entity/weeper_skull_wither"
            },
            "geometry": {
                "default": "geometry.weeper_skull"
            },
            "animations": {
                "move": "animation.sprojectile.face"
            },
            "scripts": {
                "pre_animation": [
                    "variable.shake = query.shake_time - query.frame_alpha;",
                    "variable.shake_power = variable.shake > 0.0 ? -Math.sin(variable.shake * 200.0) * variable.shake : 0.0;",
                    "variable.size = query.property('spimton:size') / 4 + 0.5;"
                ],
                "scale": "variable.size",
                "animate": [
                    "move"
                ]
            },
            "render_controllers": [
                "controller.render.arrow"
            ]
        }
    }
}