{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "spimton:fist_of_the_north_star",
            "materials": {
                "default": "arrow"
            },
            "textures": {
                "default": "textures/entity/fist_of_the_north_star"
            },
            "geometry": {
                "default": "geometry.fotns"
            },
            "animations": {
                "move": "animation.sprojectile.face"
            },
            "scripts": {
                "pre_animation": [
                    "variable.shake = query.shake_time - query.frame_alpha;",
                    "variable.shake_power = variable.shake > 0.0 ? -Math.sin(variable.shake * 200.0) * variable.shake : 0.0;",
                    "variable.size = 1 + query.property('spimton:powerup') / 16;"
                ],
                "scale": "variable.size",
                "animate": [
                    "move"
                ]
            },
            "render_controllers": [
                "controller.render.arrow"
            ]
        }
    }
}