{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "spimton:hellglin",
            "materials": {
                "default": "hoglin"
            },
            "textures": {
                "default": "textures/entity/hellglin"
            },
            "geometry": {
                "default": "geometry.hellglin",
                "armor": "geometry.hellglin_armor"
            },
            "spawn_egg": {
                "texture": "spawn_egg_hoglin"
            },
            "scripts": {
                "pre_animation": [
                    "variable.tcos_right_side = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
                    "variable.tcos_left_side = -variable.tcos_right_side;",
                    "variable.attack_head_rot =  Math.sin(variable.attack_time * 180.0) * -37.3;"
                ],
                "animate": [
                    "attack_c",
                    "look_at_target_c",
                    "walk_c"
                ]
            },
            "animations": {
                "look_at_target_c": "controller.animation.hoglin.look_at_target",
                "walk_c": "controller.animation.hoglin.walk",
                "attack_c": "controller.animation.hoglin.attack",
                "walk": "animation.hoglin.walk",
                "look_at_target": "animation.hoglin.look_at_target",
                "attack": "animation.hoglin.attack"
            },
            "render_controllers": [
                "controller.render.hoglin",
                "controller.render.hellglin_armor"
            ]
        }
    }
}