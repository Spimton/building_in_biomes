{
    "format_version": "1.21.80",
    "minecraft:block_culling_rules": {
        "description": {
            "identifier": "spimton:culling.custom_glass_pane"
        },
        "rules": [
            // North extension: cull its outward north face
            // when another ominous_stained_glass_pane is directly north.
            {
                "geometry_part": {
                    "bone": "north",
                    "cube": 0,
                    "face": "north"
                },
                "direction": "north",
                "condition": "same_block"
            },
            // South extension: cull its outward south face
            // when another ominous_stained_glass_pane is directly south.
            {
                "geometry_part": {
                    "bone": "south",
                    "cube": 0,
                    "face": "south"
                },
                "direction": "south",
                "condition": "same_block"
            },
            // East extension: cull its outward east face
            // when another ominous_stained_glass_pane is directly east.
            {
                "geometry_part": {
                    "bone": "east",
                    "cube": 0,
                    "face": "north"
                },
                "direction": "east",
                "condition": "same_block"
            },
            // West extension: cull its outward west face
            // when another ominous_stained_glass_pane is directly west.
            {
                "geometry_part": {
                    "bone": "west",
                    "cube": 0,
                    "face": "south"
                },
                "direction": "west",
                "condition": "same_block"
            }
        ]
    }
}