{
    "format_version": "1.21.120",
    "minecraft:entity": {
        "description": {
            "identifier": "spimton:darkened_sai",
            "is_spawnable": false,
            "is_summonable": true,
            "runtime_identifier": "arrow"
        },
        "component_groups": {
            "despawn": {
                "minecraft:instant_despawn": {}
            },
            "minecraft:pillager_arrow": {
                "minecraft:projectile": {
                    "on_hit": {
                        "impact_damage": {
                            "damage": [
                                4,
                                8
                            ],
                            "knockback": true,
                            "semi_random_diff_damage": false,
                            "destroy_on_hit": false,
                            "should_bounce": false
                        },
                        "particle_on_hit": {
                            "on_entity_hit": true,
                            "on_other_hit": true,
                            "particle_type": "crit"
                        }
                    },
                    "multiple_targets": true,
                    "power": 1.6,
                    "gravity": 0.01997,
                    "inertia": 1,
                    "uncertainty_base": 1,
                    "uncertainty_multiplier": 1,
                    "anchor": 1,
                    "should_bounce": false,
                    "offset": [
                        0,
                        -0.1,
                        0
                    ]
                },
                "minecraft:despawn": {
                    "min_range_inactivity_timer": 10,
                    "despawn_from_inactivity": true,
                    "despawn_from_distance": {
                        "max_distance": 128,
                        "min_distance": 32
                    },
                    "despawn_from_simulation_edge": true
                }
            }
        },
        "components": {
            "minecraft:type_family": {
                "family": [
                    "inanimate"
                ]
            },
            "minecraft:collision_box": {
                "width": 0.25,
                "height": 0.25
            },
            "minecraft:hurt_on_condition": {
                "damage_conditions": [
                    {
                        "filters": {
                            "test": "in_lava",
                            "subject": "self",
                            "operator": "==",
                            "value": true
                        },
                        "cause": "lava",
                        "damage_per_tick": 4
                    }
                ]
            },
            "minecraft:projectile": {
                "on_hit": {
                    "impact_damage": {
                        "damage": [
                            1,
                            4
                        ],
                        "knockback": true,
                        "semi_random_diff_damage": false,
                        "destroy_on_hit": true
                    },
                    "stick_in_ground": {
                        "shake_time": 0.35
                    }
                },
                "power": 1.6,
                "gravity": 0.05,
                "uncertainty_base": 16,
                "uncertainty_multiplier": 4,
                "anchor": 1,
                "should_bounce": true,
                "offset": [
                    0,
                    -0.1,
                    0
                ]
            },
            "minecraft:physics": {},
            "minecraft:dimension_bound": {},
            "minecraft:pushable": {
                "is_pushable": false,
                "is_pushable_by_piston": true
            },
            "minecraft:damage_sensor": {
                "triggers": {
                    "cause": "all",
                    "deals_damage": "no"
                }
            },
            "minecraft:environment_sensor": {
                "triggers": {
                    "event": "spimton:despawn",
                    "filters": {
                        "test": "in_block"
                    }
                }
            },
            "minecraft:health": {
                "max": 1,
                "value": 1
            },
            "minecraft:conditional_bandwidth_optimization": {
                "default_values": {
                    "max_optimized_distance": 80.0,
                    "max_dropped_ticks": 7,
                    "use_motion_prediction_hints": true
                }
            }
        },
        "events": {
            "spimton:despawn": {
                "add": {
                    "component_groups": [
                        "despawn"
                    ]
                }
            },
            "minecraft:entity_spawned": {
                "sequence": [
                    {
                        "add": {
                            "component_groups": [
                                "minecraft:pillager_arrow"
                            ]
                        }
                    }
                ]
            }
        }
    }
}