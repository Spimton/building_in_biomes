                    "impact_damage": {
                        "damage": 19
                    }
                },
                "multiple_targets": true,
                "power": 1.225,
                "gravity": 0,
                "inertia": 1,
                "uncertainty_base": 20,
                "uncertainty_multiplier": 4,
                "anchor": 1,
                "hit_sound": "soul_bolt.hit",
                "shoot_sound": "soul_bolt.shoot",
                "should_bounce": false,
                "offset": [
                    0,
                    -0.1,
                    0
                ]
