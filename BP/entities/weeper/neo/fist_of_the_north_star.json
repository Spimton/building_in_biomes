{
    "format_version": "1.21.120",
    "minecraft:entity": {
        "description": {
            "identifier": "spimton:fist_of_the_north_star",
            "is_spawnable": false,
            "is_summonable": true,
            "runtime_identifier": "arrow",
            "properties": {
                "spimton:powerup": {
                    "client_sync": true,
                    "type": "int",
                    "range": [
                        0,
                        1225
                    ],
                    "default": 0
                }
            }
        },
        "component_groups": {
            "spimton:explode": {
                "minecraft:explode": {
                    "fuse_lit": true,
                    "fuse_length": 0,
                    "damage_scaling": 1.997,
                    "power": 6,
                    "breaks_blocks": true,
                    "destroy_affected_by_griefing": true
                }
            }
        },
        "components": {
            "minecraft:type_family": {
                "family": [
                    "inanimate"
                ]
            },
            "minecraft:collision_box": {
                "width": 0.25,
                "height": 0.25
            },
            "minecraft:hurt_on_condition": {
                "damage_conditions": [
                    {
                        "filters": {
                            "test": "in_lava",
                            "subject": "self",
                            "operator": "==",
                            "value": true
                        },
                        "cause": "lava",
                        "damage_per_tick": 4
                    }
                ]
            },
            "minecraft:projectile": {
                "on_hit": {
                    "particle_on_hit": {
