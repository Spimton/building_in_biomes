            "minecraft:health": {
                "max": 1,
                "value": 1
            },
            "minecraft:conditional_bandwidth_optimization": {
                "default_values": {
                    "max_optimized_distance": 80.0,
                    "max_dropped_ticks": 7,
                    "use_motion_prediction_hints": true
                }
            }
        },
        "events": {
            "spimton:home": {
                "queue_command": {
                    "target": "self",
                    "command": [
                        "scriptevent spimton:redirect spimton:weeper_target;1.225"
                    ]
                }
            },
