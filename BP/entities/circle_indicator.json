                    "entities": {
                        "num_to_spawn": 1,
                        "spawn_entity": "spimton:justice_bell",
                        "spawn_method": "born",
                        "single_use": true,
                        "min_wait_time": 0,
                        "max_wait_time": 0,
                        "should_leash": false
                    }
                },
                "minecraft:timer": {
                    "time": 2,
                    "time_down_event": {
